{
  "name": "pushai-monorepo",
  "private": "true",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:watch": "turbo run dev:watch",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf .turbo node_modules && bun install",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:migrate": "bunx biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.13"
    }
  }
}
