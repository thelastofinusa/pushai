{
  "name": "@pushai/types",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelastofinusa/pushai.git",
    "directory": "packages/types"
  },
  "keywords": [
    "git",
    "types",
    "ai",
    "commit",
    "conventional-commits"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsc --watch",
    "lint": "biome check .",
    "clean": "rm -rf .turbo dist node_modules",
    "pack:dry": "bun run build && bun pm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@pushai/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^22.20.2",
    "tsdown": "0.22.14"
  }
}
